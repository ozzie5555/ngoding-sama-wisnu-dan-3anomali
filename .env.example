# Salin menjadi .env.local untuk development.
# Untuk deployment, isi nama variabel yang sama melalui Vercel Project Settings.
# Jangan commit .env.local atau secret backend.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_TURNSTILE_SITE_KEY=

# Aktif untuk presentasi/lomba selama provider OTP asli belum tersedia.
# Ini bukan verifikasi nomor sungguhan; kode demo yang dipakai adalah 1234.
VITE_ENABLE_DEMO_OTP=true
